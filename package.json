{
  "name": "consent.colognifornia.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import ./dist/src/sentry/instrument.js dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias",
    "lint": "eslint src",
