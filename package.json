    "sentry:sourcemaps": "sentry-cli sourcemaps inject ./dist && sentry-cli sourcemaps upload ./dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@redis/client": "^6.3.0",
    "@sentry/node": "^11.4.0",
    "@sentry/profiling-node": "^11.4.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.7.4",
    "hono-pino": "^0.10.3",
    "hono-rate-limiter": "^0.5.4",
    "neoip": "^3.1.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.1",
    "stoker": "^2.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.8.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
